## Copy to local.properties (gitignored) and fill in values.
## Never commit real keys.

# Android SDK path (Android Studio usually writes this automatically)
# sdk.dir=/Users/YOU/Library/Android/sdk

# Google Sign-In — Web client ID is BAKED in BuildConfig for v1.5+
# (555526836064-aria393bjpcgr17j6fatl0nbeqtvqri6.apps.googleusercontent.com).
# Optional override only:
# GOOGLE_WEB_CLIENT_ID=

# AI keys: leave EMPTY. Never ship developer keys.
# Users paste their own Gemini key in Connect Gemini / Settings.
# Do NOT put the Firebase api_key here as a Gemini key.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
