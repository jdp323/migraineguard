## Copy to local.properties (gitignored) and fill in values.
## Never commit real keys or client IDs with secrets.

# Android SDK path (Android Studio usually writes this automatically)
# sdk.dir=/Users/YOU/Library/Android/sdk

# Google Sign-In / Credential Manager — Web client ID from Google Cloud Console
# Build succeeds without this; Google button falls back to demo mode.
# GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# AI provider keys (optional free tiers; BuildConfig fields — never commit)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
